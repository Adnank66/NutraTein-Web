# ==========================================
# NUTRATEIN ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or .env.local and populate secrets
# ==========================================

# Database Connection (MongoDB Atlas)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/Proteinweb?retryWrites=true&w=majority"
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/Proteinweb?retryWrites=true&w=majority"

# NextAuth / Authentication Secrets
AUTH_SECRET="your-nextauth-jwt-secret-key-min-32-chars"
NEXTAUTH_SECRET="your-nextauth-jwt-secret-key-min-32-chars"
CRON_SECRET="replace-with-a-long-random-cron-secret"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Application Settings
PORT=3000
# NOTE: Do NOT set NODE_ENV here. Next.js sets NODE_ENV=production automatically during build and start.
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Accounts Configuration
ADMIN_EMAIL="nutratein@gmail.com"
ADMIN_PASSWORD="your-strong-admin-password"
SUPER_ADMIN_EMAIL="adnankazi275@gmail.com"
SUPER_ADMIN_PASSWORD="your-strong-super-admin-password"

# Optional Data Migration from Previous Cluster
# OLD_MONGODB_URI="mongodb+srv://<old_user>:<old_password>@<old_cluster>.mongodb.net/<old_db>"

# Google Gemini AI Assistant (Server-Side Only - Keep Secret)
GEMINI_API_KEY="your-gemini-api-key"

# Cloudinary Media Storage (Server & Client Uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# SMTP Email Service (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-google-app-password"
SMTP_EMAIL="your-email@gmail.com"
SMTP_PASSWORD="your-google-app-password"
MAIL_FROM_NAME="NUTRATEIN"
MAIL_FROM_ADDRESS="support@nutratein.in"
MAIL_REPLY_TO="support@nutratein.in"

