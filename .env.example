# ==========================================
# NUTRATEIN ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or .env.local and populate secrets
# ==========================================

# Database Connection (MongoDB Atlas)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/Proteinweb?retryWrites=true&w=majority"
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/Proteinweb?retryWrites=true&w=majority"

# NextAuth / Authentication Secrets
AUTH_SECRET="your-nextauth-jwt-secret-key-min-32-chars"
NEXTAUTH_SECRET="your-nextauth-jwt-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Application Settings
PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# Google Gemini AI Assistant (Server-Side Only - Keep Secret)
GEMINI_API_KEY=

# SMTP Email Service (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-google-app-password"
SMTP_EMAIL="your-email@gmail.com"
SMTP_PASSWORD="your-google-app-password"
MAIL_FROM_NAME="NUTRATEIN"
MAIL_FROM_ADDRESS="support@nutratein.com"
MAIL_REPLY_TO="support@nutratein.com"

# Supabase Postgres
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

