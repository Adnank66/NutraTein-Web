PORT=5000
MONGO_URI=mongodb://localhost:27017/proteinx
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Comma-separated browser origins permitted to make credentialed requests.
# Required in production; FRONTEND_URL is used when this is unset.
CORS_ALLOWED_ORIGINS=https://app.example.com
ADMIN_EMAIL="admin@nutratein.in"
ADMIN_PASSWORD="your-strong-admin-password"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_SECURE=false
MAIL_FROM_NAME=PROTEINX
MAIL_FROM_ADDRESS=noreply@proteinx.in
MAIL_REPLY_TO=support@proteinx.in
GEMINI_API_KEY=
